// Leap.app target. Same in Debug and Release; configuration-specific
// settings live in Debug.xcconfig / Release.xcconfig.

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_ENTITLEMENTS = Leap/Leap.entitlements
CODE_SIGN_STYLE = Automatic
COMBINE_HIDPI_IMAGES = YES
ENABLE_HARDENED_RUNTIME = YES
// INFOPLIST_FILE is emitted by XcodeGen from the target's sources.
GENERATE_INFOPLIST_FILE = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
PRODUCT_BUNDLE_IDENTIFIER = com.antavik.leap
PRODUCT_NAME = $(TARGET_NAME)
SWIFT_EMIT_LOC_STRINGS = YES
