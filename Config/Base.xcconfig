// Settings shared by every target and configuration.

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
COPY_PHASE_STRIP = NO
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_C_LANGUAGE_STANDARD = gnu17
GCC_NO_COMMON_BLOCKS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
MACOSX_DEPLOYMENT_TARGET = 14.0
MTL_FAST_MATH = YES
SDKROOT = macosx
SWIFT_VERSION = 6.0

// Version stamped into every bundle. Bump here, not per target.
// CFBundleVersion. chronod decides whether the widget's cached renders are
// stale by comparing this against the record it already holds: ship the same
// value twice and an updated widget keeps drawing the previous build until its
// timeline runs out. It must strictly increase for every release. The Makefile
// overrides it per build; this is the fallback for builds started from Xcode.
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0

// Short git hash of the built commit, shown in the About panel. The Makefile
// overrides it on the xcodebuild command line; this is the fallback for builds
// started from Xcode, where no git information is available.
LEAP_BUILD_COMMIT = dev
