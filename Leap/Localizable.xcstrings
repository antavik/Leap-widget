    "Leap Widget and its settings will be moved to the Trash, and its widgets will disappear from the Desktop and Notification Center." : {
      "comment" : "Uninstall confirmation message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leap Widget and its settings will be moved to the Trash, and its widgets will disappear from the Desktop and Notification Center."
          }
        }
      }
    },
    "Leap Widget could not hand the uninstall over to Homebrew. %@" : {
